{
  "Name": "Minimal MP4",
  "MaxStreamingBitrate": 8000000,
  "DirectPlayProfiles": [
    {
      "Container": "mp4,m4v",
      "Type": "Video",
      "VideoCodec": "h264",
      "AudioCodec": "aac"
    }
  ],
  "TranscodingProfiles": [
    {
      "Container": "ts",
      "Type": "Video",
      "VideoCodec": "h264",
      "AudioCodec": "aac",
      "Protocol": "hls",
      "Context": "Streaming",
      "MaxAudioChannels": "2"
    }
  ],
  "CodecProfiles": [
    {
      "Type": "Video",
      "Codec": "h264",
      "Conditions": [
        { "Condition": "LessThanEqual", "Property": "Width", "Value": "1920", "IsRequired": false },
        { "Condition": "LessThanEqual", "Property": "Height", "Value": "1080", "IsRequired": false },
        { "Condition": "LessThanEqual", "Property": "VideoBitDepth", "Value": "8", "IsRequired": false },
        { "Condition": "LessThanEqual", "Property": "VideoFramerate", "Value": "60", "IsRequired": false }
      ]
    },
    {
      "Type": "VideoAudio",
      "Codec": "aac",
      "Conditions": [
        { "Condition": "LessThanEqual", "Property": "AudioChannels", "Value": "2", "IsRequired": false }
      ]
    }
  ],
  "SubtitleProfiles": [
    { "Format": "vtt", "Method": "External" }
  ]
}
